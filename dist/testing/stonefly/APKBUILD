# Maintainer: Alexandru Ungur <alexaandru@gmail.com>
pkgname=stonefly
pkgver=0.0.1
pkgrel=0
pkgdesc="Wayland compositor/WM (tinywl 0.20 seed)"
url="https://github.com/alexaandru/stonefly"
arch="all"
license="MIT"
depends="
	foot
	scenefx
	wlroots0.20
	"
makedepends="
	clang
	libxkbcommon-dev
	meson
	samurai
	scenefx-dev
	wayland-dev
	wayland-protocols
	wlroots0.20-dev
	"
options="!check"
source="stonefly-$pkgver.tar.gz"
builddir="$srcdir/stonefly-$pkgver"

build() {
	export CC=clang
	abuild-meson . output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
f3522362be5282fd71fbd62abab29dfd694826eace9afe268335558be52080ae15470c79951fc83aec9aa869a0fe8cc6c4254927977bc74cef94abcedcefd17e  stonefly-0.0.1.tar.gz
"
