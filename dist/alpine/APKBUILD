# Maintainer: Alexandru Ungur <alexaandru@gmail.com>
pkgname=stonefly
pkgver=0.0.1
pkgrel=0
pkgdesc="Wayland compositor/WM (tinywl 0.20 seed)"
url="https://github.com/alexaandru/stonefly"
arch="all"
license="MIT"
# Runtime: only shared libs the binary actually links.
# clang / meson / *-dev are build-only — never put them in depends.
# foot/ghostty/noctalia are spawn targets from config, not package deps.
makedepends="
	clang
	compiler-rt
	libxkbcommon-dev
	luajit-dev
	meson
	samurai
	scenefx-dev
	wayland-dev
	wayland-protocols
	wlroots0.20-dev
	"
# !strip: keep symbols so ASan/UBSan traces are useful while we ship sanitizer builds.
options="!check !strip"
source="stonefly-$pkgver.tar.gz"
builddir="$srcdir/stonefly-$pkgver"

build() {
	# clang is the *build* compiler only (ASan needs compiler-rt on Alpine).
	# Users never need clang installed to run the APK.
	export CC=clang
	# TEMPORARY: always ship a sanitizer debug build (even for "releases") so
	# compositor crashes (taskbar, VT switch, …) get actionable traces. Keep
	# the real release stanza below commented until crash hunting is done —
	# then restore it and drop -Db_sanitize / !strip / compiler-rt.
	# compiler-rt supplies libclang_rt.asan*.a for clang -fsanitize= on Alpine.
	#
	# abuild-meson \
	# 	--buildtype=release \
	# 	. output
	abuild-meson \
		--buildtype=debugoptimized \
		-Db_sanitize=address,undefined \
		. output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
b689b62be1e48d3e5fc7aec0039698e14b4c3983a95ca74312f2c728b779862694c7ead254831344c2a1997fbbbe09652fb71ad17d6613d56e46065a28866f18  stonefly-0.0.1.tar.gz
"
