;; Day-zero knobs (was src/config/hardcoded.h macros).
(set stonefly.opt.scale 1.5)
(set stonefly.opt.cursor_size 24)
(set stonefly.opt.gap 15)
(set stonefly.opt.cascade_step 25)
(set stonefly.opt.cascade_wrap 10)
(set stonefly.opt.slide_duration_ms 200)
(set stonefly.opt.slide_dir_closest true)
(set stonefly.opt.morph_duration_ms 200)
(set stonefly.opt.client_opacity 0.96)
(set stonefly.opt.corner_radius 12)
(set stonefly.opt.border_thickness 3)
(set stonefly.opt.shadow_blur_sigma 20.0)
(set stonefly.opt.border_active [0.10 0.75 1.00 1.00])
(set stonefly.opt.border_inactive [0.22 0.22 0.24 1.00])
(set stonefly.opt.border_urgent [1.00 0.45 0.10 1.00])
(set stonefly.opt.shadow_color [0.0 0.0 0.0 0.55])
(set stonefly.opt.window_blur false)
(set stonefly.opt.bell_flash_ms 200)
(set stonefly.opt.snap_threshold 26)
(set stonefly.opt.snap_preview_border 1)
(set stonefly.opt.snap_preview_opacity 0.40)
(set stonefly.opt.tap_max_hold_ms 500)
(set stonefly.opt.double_tap_gap_ms 300)

(set stonefly.opt.cmd_foot "foot")
(set stonefly.opt.cmd_nautilus "nautilus")
(set stonefly.opt.cmd_ghostty "ghostty +new-window")
(set stonefly.opt.cmd_ghostty_qt "ghostty +toggle-quick-terminal")
(set stonefly.opt.cmd_editor "gtk-launch org.gnome.TextEditor")
(set stonefly.opt.cmd_launcher "noctalia msg panel-toggle launcher")
